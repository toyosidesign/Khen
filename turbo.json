{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "check": { "cache": false },
    "@tp/tokens#build": {
      "inputs": ["src/index.ts"],
      "outputs": ["src/tokens.css", "src/figma-variables.json"]
    }
  }
}
