# Netlify header rules. Must sit at the publish-dir root to take effect —
# scripts/build-site.mjs copies this file into _site/.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # SAMEORIGIN, not DENY: preview.html iframes previews/ from the same origin.
  X-Frame-Options: SAMEORIGIN
  # 'unsafe-inline' is required because every template inlines its own CSS/JS.
  # The only external origins these pages use are Google Fonts.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; frame-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com

# Previews are cheap to regenerate and should not be cached stale after a rebuild.
/previews/*
  Cache-Control: public, max-age=300, must-revalidate

# Long-cache the imagery the previews depend on.
/templates/assets/*
  Cache-Control: public, max-age=31536000, immutable
