{
  "name": "template-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm previews && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "previews": "node scripts/build-previews.mjs",
    "previews:test": "node --test scripts/build-previews.test.mjs",
    "site": "node scripts/build-site.mjs",
    "deliver": "node scripts/stamp-delivery.mjs stamp",
    "deliver:verify": "node scripts/stamp-delivery.mjs verify",
    "tokens:build": "turbo run build --filter=@tp/tokens",
    "tokens:check": "turbo run check --filter=@tp/tokens"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
